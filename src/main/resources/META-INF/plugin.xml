<!-- Plugin Configuration File. See https://plugins.jetbrains.com/docs/intellij/plugin-configuration-file.html -->
<idea-plugin>
  <id>com.ericfortis.tailwindeye</id>
  <name>Tailwind Eye</name>
  <vendor>ericfortis</vendor>

  <depends>com.intellij.modules.platform</depends>
  <depends>com.intellij.modules.javascript</depends>
  <depends>com.intellij.react</depends>

  <actions>
    <action id="TailwindEye.Toggle"
            class="com.ericfortis.tailwindeye.ToggleAction"
            text="Toggle Tailwind Eye"
            description="Either Folds classNames or Fades non-classNames">
      <add-to-group group-id="ViewMenu" anchor="last"/>
      <keyboard-shortcut keymap="$default" first-keystroke="shift alt F"/>
    </action>
    <action id="TailwindEye.TurnOff"
            class="com.ericfortis.tailwindeye.TurnOffAction"
            text="Turn Off Tailwind Eye"
            description="Turns off all Tailwind Eye effects">
      <add-to-group group-id="ViewMenu" anchor="after" relative-to-action="TailwindEye.Toggle"/>
    </action>
    <action id="TailwindEye.EditString"
            class="com.ericfortis.tailwindeye.ExpandClassNameAction"
            text="Expand ClassName"
            description="Convert className string to multiline template literal">
      <keyboard-shortcut keymap="$default" first-keystroke="control shift I"/>
    </action>
  </actions>

  <extensions defaultExtensionNs="com.intellij">
    <lang.foldingBuilder language="HTML" implementationClass="com.ericfortis.tailwindeye.ClassNameFolding"/>
    <lang.foldingBuilder language="ECMAScript 6" implementationClass="com.ericfortis.tailwindeye.ClassNameFolding"/>
    <lang.foldingBuilder language="JavaScript JSX" implementationClass="com.ericfortis.tailwindeye.ClassNameFolding"/>
    <lang.foldingBuilder language="TypeScript JSX" implementationClass="com.ericfortis.tailwindeye.ClassNameFolding"/>

    <annotator language="ECMAScript 6" implementationClass="com.ericfortis.tailwindeye.SyntaxFader"/>
    <annotator language="HTML" implementationClass="com.ericfortis.tailwindeye.SyntaxFader"/>
    <annotator language="JavaScript JSX" implementationClass="com.ericfortis.tailwindeye.SyntaxFader"/>
    <annotator language="TypeScript JSX" implementationClass="com.ericfortis.tailwindeye.SyntaxFader"/>

    <additionalTextAttributes scheme="Default" file="colorSchemes/TailwindEyeDefault.xml"/>
    <additionalTextAttributes scheme="Darcula" file="colorSchemes/TailwindEyeDarcula.xml"/>
    <colorSettingsPage implementation="com.ericfortis.tailwindeye.SettingsPage"/>
  </extensions>
</idea-plugin>
